---
// The Security section: groups of topics, see DocGroups.
import DocGroups from './DocGroups.astro';
import { inline } from '../lib/inline';
import Heading from './Heading.astro';
import { en } from '../i18n/en';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale).security;
---

<section class="section docs" id="security">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{d.eyebrow}</p>
      <Heading as="h2" id="security" own={false} locale={locale}>{d.title}</Heading>
      <p class="lede" set:html={inline(d.lede)} />
    </div>

    <DocGroups locale={locale} groups={d.groups} source={en.security.groups} />
  </div>
</section>
