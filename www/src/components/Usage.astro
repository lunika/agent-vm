---
import CodeBlock from './CodeBlock.astro';
import { inline } from '../lib/inline';
import Heading from './Heading.astro';
import { slug } from '../lib/slug';
import { en } from '../i18n/en';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
---

<section class="section" id="usage">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{d.usage.eyebrow}</p>
      <Heading as="h2" id="usage" own={false} locale={locale}>{d.usage.title}</Heading>
      <p class="lede" set:html={inline(d.usage.lede)} />
    </div>

    <div class="usage__cards">
      {
        d.usage.cards.map((card, index) => (
          <article class="usage__card">
            <Heading as="h3" id={slug(en.usage.cards[index]!.title)} locale={locale} class="usage__card-title">{card.title}</Heading>
            <p class="prose usage__card-body" set:html={inline(card.body)} />
            <CodeBlock locale={locale} code={card.code} class="usage__card-code" />
          </article>
        ))
      }
    </div>

    <div class="usage__split">
      <div class="usage__git">
        <Heading as="h3" id={slug(en.usage.gitTitle)} locale={locale} class="usage__sub">{d.usage.gitTitle}</Heading>
        <p class="prose usage__sub-body" set:html={inline(d.usage.gitBody)} />
        <CodeBlock locale={locale} code={d.usage.gitCode} />
      </div>

      <div class="usage__git">
        <p class="prose usage__note" set:html={inline(d.usage.gitNote)} />
        <div class="note note--accent">
          <strong class="note__title">{d.usage.gitHumanTitle}</strong>
          <p class="prose usage__note" set:html={inline(d.usage.gitHumanBody)} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .usage__cards {
    display: grid;
    /* 28rem so two columns fit the container: at three, the trailing `#`
       comments in the samples get clipped and need sideways scrolling. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .usage__card {
    display: grid;
    align-content: start;
    /* Without this a grid item keeps min-width:auto and a wide code block
       pushes the card past its track, over the neighbouring column. */
    min-width: 0;
    gap: 0.85rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    background: var(--surface);
  }

  .usage__card-title {
    font-size: 1.02rem;
  }

  .usage__card-body {
    font-size: 0.91rem;
  }

  .usage__card-code {
    margin-top: 0.15rem;
  }

  /* An odd card count would otherwise leave a hole in the last row. */
  .usage__card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .usage__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .usage__git {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
  }

  .usage__sub {
    font-size: 1.05rem;
  }

  .usage__sub-body {
    font-size: 0.93rem;
    margin-top: -0.35rem;
  }

  .usage__note {
    font-size: 0.88rem;
  }

  @media (max-width: 62rem) {
    .usage__split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
